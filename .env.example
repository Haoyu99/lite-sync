# Domain configured in your reverse proxy. Used only to print the one-time setup link.
LITE_SYNC_DOMAIN=sync.example.com

# Port on 127.0.0.1 for the reverse proxy to forward to.
LITE_SYNC_PORT=28470

# Encrypts the TOTP secret stored on the server. Generate with: openssl rand -base64 48
# Back this file up with the data directory. Losing it only requires enrolling TOTP again.
LITE_SYNC_SERVER_KEY=
